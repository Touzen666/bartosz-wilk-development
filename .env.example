# ============================================================
# Wilk Development — zmienne środowiskowe
# Skopiuj ten plik jako .env i uzupełnij wartościami z Vercel
# ============================================================

# ─── Baza danych PostgreSQL (Supabase) ───────────────────────────────────────
# Główne URL dla Prismy (z pgBouncer — connection pooling)
POSTGRES_PRISMA_URL="postgres://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&pgbouncer=true"

# URL bezpośredni (bez poolera — do migracji i Prisma Studio)
POSTGRES_URL_NON_POOLING="postgres://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# URL z poolerem (Supabase base-pooler)
POSTGRES_URL="postgres://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&supa=base-pooler.x"

# Dane szczegółowe połączenia
POSTGRES_HOST="db.xohdpqbaoxennpgtybzk.supabase.co"
POSTGRES_DATABASE="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="[PASSWORD]"

# ─── Supabase — klucze API ────────────────────────────────────────────────────
BARTOSZ_WILK_DEVSUPABASE_URL="https://xohdpqbaoxennpgtybzk.supabase.co"
BARTOSZ_WILK_DEVSUPABASE_ANON_KEY="[ANON_KEY]"
BARTOSZ_WILK_DEVSUPABASE_PUBLISHABLE_KEY="sb_publishable_[KEY]"

# Klucze serwisowe (tylko po stronie serwera — nigdy nie eksponuj publicznie)
SUPABASE_JWT_SECRET="[JWT_SECRET]"
SUPABASE_SECRET_KEY="sb_secret_[SECRET_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# ─── Vercel Blob — przechowywanie obrazków ────────────────────────────────────
# Token do odczytu i zapisu plików w Vercel Blob Storage
BLOB_READ_WRITE_TOKEN="vercelblob:[TOKEN]"

# ─── Strona (SEO) ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL="https://wilkdevelopment.pl"

# ─── NextAuth (OAuth + JWT) ───────────────────────────────────────────────────
# Wygeneruj: openssl rand -base64 32
NEXTAUTH_SECRET="[WYGENERUJ_LOSOWY_STRING]"
NEXTAUTH_URL="https://wilkdevelopment.pl"

# Opcjonalne dane admina (jeśli nie podano, używane są wartości domyślne z seed)
# ADMIN_EMAIL="admin@wilkdevelopment.pl"
# ADMIN_PASSWORD="Admin@2025"
